# Supabase configuration (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side only for background sync cron jobs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API (Server-side only)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# GitHub Roadmap Repository
GITHUB_REPO_URL=https://github.com/adi-training/swe-roadmap
GITHUB_REPO_BRANCH=main
GITHUB_TOKEN=your-optional-github-pat
